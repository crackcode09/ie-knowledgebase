   "task": "Train production personnel in new or existing methods.",
   "type": "Core",
   "importance": 3.56
  },
  {
   "id": "20963",
   "task": "Design tests of finished products or process capabilities to establish standards or validate process requirements.",
   "type": "Core",
   "importance": 3.48
  },
  {
   "id": "19649",
   "task": "Analyze the financial impacts of sustainable manufacturing processes or sustainable product manufacturing.",
   "type": "Core",
   "importance": 3.37
  },
  {
   "id": "19650",
   "task": "Develop sustainable manufacturing technologies to reduce greenhouse gas emissions, minimize raw material use, replace toxic materials with non-toxic materials, replace non-renewable materials with renewable materials, or reduce waste.",
   "type": "Core",
   "importance": 3.32
  },
  {
   "id": "18179",
   "task": "Purchase equipment, materials, or parts.",
   "type": "Core",
   "importance": 3.25
  },
  {
   "id": "19651",
   "task": "Evaluate current or proposed manufacturing processes or practices for environmental sustainability, considering factors such as greenhouse gas emissions, air pollution, water pollution, energy use, or waste creation.",
   "type": "Core",
   "importance": 3.09
  },
  {
   "id": "18184",
   "task": "Read current literature, talk with colleagues, participate in educational programs, attend meetings or workshops, or participate in professional organizations or conferences to keep abreast of developments in the manufacturing field.",
   "type": "Core",
   "importance": 3.08
  },
  {
