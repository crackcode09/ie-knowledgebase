 "tasks": [
  {
   "id": "18181",
   "task": "Troubleshoot new or existing product problems involving designs, materials, or processes.",
   "type": "Core",
   "importance": 4.35
  },
  {
   "id": "18177",
   "task": "Investigate or resolve operational problems, such as material use variances or bottlenecks.",
   "type": "Core",
   "importance": 4.27
  },
  {
   "id": "20960",
   "task": "Identify opportunities or implement changes to improve manufacturing processes or products or to reduce costs, using knowledge of fabrication processes, tooling and production equipment, assembly methods, quality control standards, or product design, materials and parts.",
   "type": "Core",
   "importance": 4.19
  },
  {
   "id": "18167",
   "task": "Apply continuous improvement methods, such as lean manufacturing, to enhance manufacturing quality, reliability, or cost-effectiveness.",
   "type": "Core",
   "importance": 4.16
  },
  {
   "id": "18183",
   "task": "Provide technical expertise or support related to manufacturing.",
   "type": "Core",
   "importance": 4.04
  },
  {
   "id": "20961",
   "task": "Incorporate new manufacturing methods or processes to improve existing operations.",
   "type": "Core",
   "importance": 3.96
  },
  {
   "id": "18180",
   "task": "Review product designs for manufacturability or completeness.",
   "type": "Core",
   "importance": 3.92
  },
  {
   "id": "20962",
   "task": "Determine root causes of failures or recommend changes in designs, tolerances, or processing methods, using statistical procedures.",
   "type": "Core",
   "importance": 3.92
  },
  {
   "id": "18182",
   "task": "Prepare reports summarizing information or trends related to manufacturing performance.",
   "type": "Core",
   "importance": 3.87
  },
  {
   "id": "18178",
   "task": "Prepare documentation for new manufacturing processes or engineering procedures.",
   "type": "Core",
   "importance": 3.83
  },
  {
   "id": "18168",
   "task": "Design layout of equipment or workspaces to achieve maximum efficiency.",
   "type": "Core",
   "importance": 3.83
  },
  {
   "id": "18170",
   "task": "Communicate manufacturing capabilities, production schedules, or other information to facilitate production processes.",
   "type": "Core",
   "importance": 3.81
  },
  {
   "id": "18185",
   "task": "Supervise technicians, technologists, analysts, administrative staff, or other engineers.",
   "type": "Core",
   "importance": 3.63
  },
  {
