 "tasks": [
  {
   "id": "21051",
   "task": "Study product characteristics or customer requirements to determine validation objectives and standards.",
   "type": "Core",
   "importance": 4.63
  },
  {
   "id": "18131",
   "task": "Analyze validation test data to determine whether systems or processes have met validation criteria or to identify root causes of production problems.",
   "type": "Core",
   "importance": 4.55
  },
  {
   "id": "18129",
   "task": "Develop validation master plans, process flow diagrams, test cases, or standard operating procedures.",
   "type": "Core",
   "importance": 4.37
  },
  {
   "id": "18137",
   "task": "Prepare detailed reports or design statements, based on results of validation and qualification tests or reviews of procedures and protocols.",
   "type": "Core",
   "importance": 4.3
  },
  {
   "id": "18144",
   "task": "Maintain validation test equipment.",
   "type": "Core",
   "importance": 4.2
  },
  {
   "id": "18127",
   "task": "Conduct validation or qualification tests of new or existing processes, equipment, or software in accordance with internal protocols or external standards.",
   "type": "Core",
   "importance": 4.15
  },
  {
   "id": "18142",
   "task": "Communicate with regulatory agencies regarding compliance documentation or validation results.",
   "type": "Core",
   "importance": 4.11
  },
  {
   "id": "18146",
   "task": "Prepare, maintain, or review validation and compliance documentation, such as engineering change notices, schematics, or protocols.",
   "type": "Core",
   "importance": 4.1
  },
  {
   "id": "21052",
   "task": "Recommend resolution of identified deviations from established product or process standards.",
   "type": "Core",
   "importance": 4.0
  },
  {
   "id": "18128",
   "task": "Design validation study features, such as sampling, testing, or analytical methodologies.",
   "type": "Core",
   "importance": 3.9
  },
  {
   "id": "18130",
   "task": "Prepare validation or performance qualification protocols for new or modified manufacturing processes, systems, or equipment for production of pharmaceuticals, electronics, or other products.",
   "type": "Core",
   "importance": 3.82
  },
  {
   "id": "18133",
   "task": "Create, populate, or maintain databases for tracking validation activities, test results, or validated systems.",
   "type": "Core",
   "importance": 3.75
  },
  {
   "id": "18139",
   "task": "Resolve testing problems by modifying testing methods or revising test objectives and standards.",
   "type": "Core",
   "importance": 3.75
  },
  {
   "id": "18132",
   "task": "Conduct audits of validation or performance qualification processes to ensure compliance with internal or regulatory requirements.",
   "type": "Core",
   "importance": 3.7
  },
  {
   "id": "21053",
   "task": "Draw samples of raw materials, intermediate products, or finished products for validation testing.",
   "type": "Core",
   "importance": 3.58
  },
  {
   "id": "18134",
   "task": "Direct validation activities, such as protocol creation or testing.",
   "type": "Core",
   "importance": 3.55
  },
  {
   "id": "18143",
   "task": "Coordinate the implementation or scheduling of validation testing with affected departments and personnel.",
   "type": "Core",
   "importance": 3.5
  },
  {
   "id": "18145",
   "task": "Participate in internal or external training programs to maintain knowledge of validation principles, industry trends, or novel technologies.",
   "type": "Core",
   "importance": 3.47
  },
  {
   "id": "19647",
   "task": "Validate or characterize sustainable or environmentally friendly products, using electronic testing platforms.",
   "type": "Core",
   "importance": 3.42
  },
  {
   "id": "18141",
   "task": "Assist in training equipment operators or other staff on validation protocols and standard operating procedures.",
   "type": "Core",
   "importance": 3.35
  },
  {
   "id": "21054",
   "task": "Devise automated lab validation test stations or other test fixtures or equipment.",
