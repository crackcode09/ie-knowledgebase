  },
  {
   "id": "7378",
   "task": "Collaborate with others in the organization to ensure successful implementation of chosen problem solutions.",
   "type": "Core",
   "importance": 4.43
  },
  {
   "id": "7377",
   "task": "Formulate mathematical or simulation models of problems, relating constants and variables, restrictions, alternatives, conflicting objectives, and their numerical parameters.",
   "type": "Core",
   "importance": 4.38
  },
  {
   "id": "7387",
   "task": "Observe the current system in operation, and gather and analyze information about each of the component problems, using a variety of sources.",
   "type": "Core",
   "importance": 4.38
  },
  {
   "id": "7379",
   "task": "Analyze information obtained from management to conceptualize and define operational problems.",
   "type": "Core",
   "importance": 4.33
  },
  {
   "id": "7383",
   "task": "Study and analyze information about alternative courses of action to determine which plan will offer the best outcomes.",
   "type": "Core",
   "importance": 4.29
  },
  {
